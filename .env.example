# Maximum depth for AST traversal. Increase for deeply nested code.
AST_MAX_DEPTH=1000

# Timeout in seconds for running tests.
TEST_TIMEOUT=120

# Folder where deleted files are moved instead of being permanently removed.
TRASH_DIR=.trash

# Checkstyle config path. /google_checks.xml and /sun_checks.xml are bundled inside the checkstyle JAR.
CHECKSTYLE_CONFIG=/google_checks.xml
